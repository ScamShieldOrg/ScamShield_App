# Backend API base URL (include /api)
NEXT_PUBLIC_BE_URL=http://localhost:8080/api

# Google Sign-In web client ID (public; never put a client secret here)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Firebase Web app configuration used for phone authentication/reCAPTCHA
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
